# OpenAI Configuration
OPENAI_API_KEY=your_api_key_here

# API Server Configuration
API_HOST=127.0.0.1
API_PORT=8080
FRONTEND_DOMAIN=http://localhost:3000
ENVIRONMENT=dev

# Database Configuration
# For SQLite (dev)
DATABASE_URL=inquisitor.db

# For PostgreSQL (production - uncomment and fill in)
# DATABASE_URL=postgres://user:password@localhost:5432/inquisitor

# File Handling
TEMP_DIR=./tmp

# Cleanup Configuration
CLEANUP_ENABLED=true
CLEANUP_INTERVAL=1h
MAX_FILE_AGE=24h

# Runtime Mode (set to "true" to run CLI mode, otherwise runs API server)
CLI_MODE=false

